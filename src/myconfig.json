  "//": "Only export pin area in LEF (without any connected nets)",
  "MAGIC_WRITE_LEF_PINONLY": 1,

  "//": "--- CONFIGURATION POUR LE SILICON ART ---",
  "MACROS": {
    "silicon_art": {
      "instances": {
        "art_inst": {
          "location": [20, 20],
          "orientation": "N"
        }
      },
      "gds": ["dir::../macros/silicon_art.gds"],
      "lef": ["dir::../macros/silicon_art.lef"]
    }
  },
  "IGNORE_DISCONNECTED_MODULES": [
    "silicon_art",
    "art_inst"
  ],
  "ERROR_ON_DISCONNECTED_PINS": false
}
